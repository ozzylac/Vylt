{
  "manifest_version": 3,
  "name": "Vylt — passkeys",
  "version": "0.1.0",
  "description": "Saves website passkeys in your Vylt vault and signs in with them.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "icons": { "128": "icon.png" }
}
